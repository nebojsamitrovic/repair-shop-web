# The backend. Vite proxies /api to it in development, so this is only used in a build.
VITE_API_BASE_URL=

# Firebase web app configuration (Project settings -> Your apps -> SDK setup).
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-repairshop.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-repairshop
VITE_FIREBASE_STORAGE_BUCKET=demo-repairshop.appspot.com
VITE_FIREBASE_APP_ID=1:0:web:0

# Set when running the Firebase Auth emulator instead of a real project.
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
